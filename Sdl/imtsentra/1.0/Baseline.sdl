schema {
    namespace: imtsentra
    version: 1.0
}

enum BaselineUpdateStrategy {
    Manual
    AutoAcceptOnBranch
    Threshold
    AiAssisted
}

enum BaselineDecision {
    Accept
    Reject
    IgnoreRegion
}

type IgnoreRegion {
    x: Int!
    y: Int!
    width: Int!
    height: Int!
    reason: String
}

type Baseline {
    id: String!
    scenarioId: String!
    nodeId: String!
    screenshotPath: String!
    semanticSnapshotPath: String
    layoutMetadataPath: String
    ignoreRegions: [IgnoreRegion]
    createdAt: String!
    updatedAt: String!
    version: Int!
}

type BaselineDiff {
    baselineId: String!
    executionId: String!
    diffPercentage: Float!
    diffImagePath: String!
    decision: BaselineDecision
    decidedBy: String
    decidedAt: String
}
