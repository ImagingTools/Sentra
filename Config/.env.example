# Sentra Configuration — Environment Variables
# Copy to .env and customize

# Server
SENTRA_HOST=0.0.0.0
SENTRA_PORT=4000

# Browser Controller
SENTRA_BROWSER_PORT=9515
SENTRA_HEADLESS=true
SENTRA_VIEWPORT_WIDTH=1920
SENTRA_VIEWPORT_HEIGHT=1080

# AI Provider
SENTRA_AI_PROVIDER=openai
SENTRA_AI_API_KEY=
SENTRA_AI_MODEL=gpt-4-vision-preview

# Storage
SENTRA_DATA_DIR=./data
SENTRA_DB_PATH=./data/sentra.mdbx

# Execution
SENTRA_MAX_PARALLEL=4
SENTRA_DEFAULT_TIMEOUT=30000
